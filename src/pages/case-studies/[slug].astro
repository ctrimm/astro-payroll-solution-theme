---
import Layout from '../../layouts/Layout.astro';
import caseStudies, { industries } from '../../data/case-studies';

export async function getStaticPaths() {
  const studyPaths = caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { kind: 'study' as const, study, industry: null },
  }));

  const industryPaths = industries.map((industry) => ({
    params: { slug: industry.slug },
    props: {
      kind: 'industry' as const,
      study: null,
      industry,
      featured: caseStudies.filter((s) => industry.featured.includes(s.slug)),
    },
  }));

  return [...studyPaths, ...industryPaths];
}

const { kind, study, industry, featured = [] } = Astro.props;
const title = kind === 'study' ? study.title : industry.title;
const description = kind === 'study' ? study.description : industry.description;
---

<Layout title={`${title} | Payflo Case Studies`} description={description}>
  <main>
    <!-- Hero -->
    <section class="pt-28 pb-12 md:pt-32 md:pb-16 bg-gradient-to-b from-purple-50 to-white">
      <div class="container-custom">
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
            <li><a href="/" class="hover:text-payflo-purple">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/case-studies" class="hover:text-payflo-purple">Case Studies</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-gray-900 font-medium" aria-current="page">
              {kind === 'study' ? study.customer : industry.description}
            </li>
          </ol>
        </nav>

        <div class="max-w-3xl">
          {kind === 'study' && (
            <span class="inline-block bg-purple-100 text-payflo-purple px-4 py-1.5 rounded-full text-sm font-medium">
              {study.industry}
            </span>
          )}
          <h1 class="mt-4 text-4xl md:text-5xl font-bold leading-tight">{title}</h1>
          <p class="mt-6 text-xl text-gray-600">
            {kind === 'study' ? study.description : industry.intro}
          </p>
        </div>
      </div>
    </section>

    {kind === 'study' ? (
      <>
        <!-- Metrics -->
        <section class="pb-12">
          <div class="container-custom">
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
              {study.metrics.map((metric) => (
                <div class="feature-card text-center">
                  <p class="text-3xl font-bold gradient-text">{metric.value}</p>
                  <p class="mt-2 text-sm text-gray-600">{metric.label}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- Story -->
        <section class="pb-16 md:pb-24">
          <div class="container-custom">
            <div class="max-w-3xl space-y-12">
              {study.sections.map((section) => (
                <div>
                  <h2 class="text-2xl md:text-3xl font-bold mb-4">{section.heading}</h2>
                  {section.body?.map((paragraph) => (
                    <p class="text-gray-600 leading-relaxed mb-4">{paragraph}</p>
                  ))}
                  {section.list && (
                    <ul class="space-y-3 mt-4">
                      {section.list.map((item) => (
                        <li class="flex items-start gap-3 text-gray-600">
                          <svg class="w-5 h-5 text-payflo-purple shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                          </svg>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          </div>
        </section>
      </>
    ) : (
      <>
        <!-- Industry challenges and outcomes -->
        <section class="pb-16">
          <div class="container-custom">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
              <div>
                <h2 class="text-2xl md:text-3xl font-bold mb-6">What makes this hard</h2>
                <ul class="space-y-3">
                  {industry.challenges.map((challenge) => (
                    <li class="flex items-start gap-3 text-gray-600">
                      <svg class="w-5 h-5 text-payflo-purple shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{challenge}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h2 class="text-2xl md:text-3xl font-bold mb-6">What customers see</h2>
                <div class="space-y-4">
                  {industry.outcomes.map((outcome) => (
                    <div class="feature-card flex items-center justify-between gap-4">
                      <span class="text-gray-600">{outcome.label}</span>
                      <span class="text-xl font-bold gradient-text whitespace-nowrap">{outcome.value}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>

        {featured.length > 0 && (
          <section class="pb-16 md:pb-24">
            <div class="container-custom">
              <h2 class="text-2xl md:text-3xl font-bold mb-8">Related case studies</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {featured.map((item) => (
                  <a href={`/case-studies/${item.slug}`} class="group">
                    <div class="feature-card h-full">
                      <h3 class="text-xl font-semibold mb-2 group-hover:text-payflo-purple transition-colors duration-200">
                        {item.title}
                      </h3>
                      <p class="text-gray-600">{item.description}</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}
      </>
    )}

    <!-- CTA -->
    <section class="section bg-gradient-to-r from-payflo-purple to-payflo-blue">
      <div class="container-custom text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          Want results like these?
        </h2>
        <p class="text-white/90 text-lg max-w-2xl mx-auto mb-8">
          Tell us how you run payroll today and we will show you what changes.
        </p>
        <a href="/book-demo" class="btn bg-white text-payflo-purple hover:bg-gray-50">
          Book a demo
        </a>
      </div>
    </section>
  </main>
</Layout>
